# E-Mail-Versand der Buchungsanfragen über Resend (https://resend.com)
# 1. Kostenlosen Account erstellen, API-Key unter "API Keys" anlegen.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Wohin die Buchungsanfragen geschickt werden (mehrere mit Komma trennen).
BOOKING_TO_EMAIL=info@go-fast-rental.ch

# Absender. Ohne eigene, bei Resend verifizierte Domain nur
# "onboarding@resend.dev" möglich – dann kann Resend ausschliesslich an die
# E-Mail-Adresse des Resend-Accounts senden.
BOOKING_FROM_EMAIL=Go Fast Rental <onboarding@resend.dev>
